{
  "name": "school-forms",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "//engines": "Pins the runtime Azure App Service and the GitHub Actions build use. Node 22 reaches end of life in April 2027; Node 24 is the current LTS. Keep this in step with `node-version` in .github/workflows/*.yml and with the App Service STACK setting (docs/plans/deploy-azure.md §1).",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm-run-all build:server build:client",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "typecheck": "npm-run-all typecheck:server typecheck:client",
    "typecheck:server": "npm --workspace server run typecheck",
    "typecheck:client": "npm --workspace client run typecheck",
    "start": "node server/dist/index.js",
    "seed": "npm --workspace server run seed",
    "guide:pdf": "md-to-pdf docs/guides/user-guide.md --config-file docs/guides/md-to-pdf.config.js",
    "guide:staff:shots": "node scripts/capture-staff-guide.mjs",
    "guide:staff:pdf": "md-to-pdf docs/guides/staff/staff-guide.html --config-file docs/guides/staff/md-to-pdf.config.js",
    "guide:admin:shots": "node scripts/capture-admin-guide.mjs",
    "guide:admin:pdf": "md-to-pdf docs/guides/admin/admin-guide.html --config-file docs/guides/admin/md-to-pdf.config.js",
    "guide:admin:settings:pdf": "md-to-pdf docs/guides/admin/settings-reference.html --config-file docs/guides/admin/md-to-pdf.settings.config.js"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/mssql": "^12.3.0",
    "md-to-pdf": "^5.2.5",
    "npm-run-all": "^4.1.5"
  }
}
