# =============================================================================
# School Forms — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values. NEVER commit `.env`.
# Example:  cp .env.example .env
# -----------------------------------------------------------------------------
# Stack: Express + TypeScript backend, Drizzle ORM over `mssql`, Azure SQL
#        Serverless database. JWT (access + refresh) with role claim.
# Hosting: API runs on Azure Web Apps (App Service). SQL on Azure SQL Serverless.
# =============================================================================
#
# LOCAL DEV:
#   cp .env.example .env   then fill in the values below and run locally.
#
# AZURE WEB APPS (PRODUCTION):
#   Azure Web Apps reads configuration from **App Settings** in the portal
#   (Configuration → Application settings), NOT from a .env file on the
#   server. Mirror every key below into your App Service settings so the
#   published app picks them up. The public endpoint becomes:
#       https://<azure-webapp-name>.azurewebsites.net
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
# Port the Express API listens on (local). Azure injects the real port via PORT.
PORT=4000
# The Azure Web App name — this forms the public API endpoint below.
AZURE_WEBAPP_NAME=your-school-forms-api
# Public URL of the API. Locally it's localhost; in production it's the
# Azure Web Apps endpoint. Used for CORS + Swagger "Try it out" + the
# Google Forms webhook target.
PUBLIC_BASE_URL=http://localhost:4000
# The externally-facing API endpoint external callers (Google Apps Script
# webhook, Zapier/Power Automate) POST submissions to. In production this is
# the Azure Web Apps URL.
API_BASE_URL=https://your-school-forms-api.azurewebsites.net
# Allowed CORS origin(s) for the React+Vite frontend, comma-separated.
# Local dev vs the Azure Static/App hosted frontend.
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Database — Azure SQL (SQL Server) via Drizzle `mssql` driver / node-mssql
# -----------------------------------------------------------------------------
# NOTE: Azure SQL Serverless auto-suspends when idle. On first wake, TDS logins
# can ECONNRESET. Use a generous connectionTimeout (60s) and retry-with-backoff
# in code. Keep `encrypt=true` and `trustServerCertificate=true` for Azure.
DB_SERVER=wcpss-sql-serverless-freetier.database.windows.net
DB_PORT=1433
DB_DATABASE=school-form-data
DB_USER=wcpss-sql-admin
# Real password lives in your local `.env` (gitignored). Placeholder only here.
DB_PASSWORD=your-azure-sql-password-here

# Alternative: a single connection string. If set, this overrides the fields
# above (used by some tooling / migration runners).
# DATABASE_URL=Server=your-server.database.windows.net;Database=school_forms;User Id=your_db_user;Password=your_db_password;Encrypt=true;TrustServerCertificate=true

# node-mssql pool tuning (Azure Serverless: keep min low so idle autosuspends).
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
# First-connect warmup allowance — raise to 60000 for the Serverless wake.
DB_CONNECTION_TIMEOUT_MS=60000
DB_REQUEST_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Auth — JWT
# -----------------------------------------------------------------------------
# Generate strong secrets: `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Access token lifetime (short) and refresh lifetime (long).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated list of roles allowed to log in / register (admins + staff only).
ALLOWED_ROLES=admin,staff

# -----------------------------------------------------------------------------
# Swagger / OpenAPI
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
# Bearer auth scheme name shown in the Swagger UI.
SWAGGER_BEARER_SCHEME=bearerAuth

# -----------------------------------------------------------------------------
# Google Forms webhook (optional alternate intake path)
# -----------------------------------------------------------------------------
# When a Google Form is submitted, your Google Apps Script forwards the
# responses to:`{API_BASE_URL}/api/forms/:form_id/submit`. Protect that public
# endpoint with a shared secret so only your script (not random callers) can
# post submissions. Send it as the `X-Webhook-Secret` header.
GOOGLE_FORMS_WEBHOOK_SECRET=change-me-webhook-secret

# -----------------------------------------------------------------------------
# Rate limiting (Phase 6 hardening) — optional defaults used by the API.
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Google Docs generation (staff "Generate document" feature)
# -----------------------------------------------------------------------------
# When a staff member checks the staff-only "Generate document" checkbox on a
# submission and saves, the app copies a Google Doc template and fills its
# placeholders from the submission answers, then records the new doc.
#
# AUTH: provide EITHER the full service-account JSON inline OR a path to the .json
# key file. Leave the unused one empty. The service account needs access to the
# template doc and (optionally) the target folder.
GOOGLE_SERVICE_ACCOUNT_JSON=          # full JSON string, or leave empty
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=      # path to the .json key file, or leave empty
# The Google Doc template id to copy for each generated document.
GOOGLE_DOC_TEMPLATE_ID=               # e.g. 1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
# The Google Drive folder id where generated documents are saved.
# Leave empty to save into the service account's "My Drive" root.
GOOGLE_DOC_FOLDER_ID=                 # e.g. 1ZxYwVuTsRqPonMlKjIhGfEdCbA9876543210
